<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_DESKTOP_ID@</id>
  <name>@APP_PRODUCT@</name>
  <summary>@APP_DESCRIPTION@</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <description>
    <p>
      UartX is a serial terminal for working with any device that communicates
      over UART. It displays incoming data in real time, highlights the lines
      that matter using rules you define, lets you view a filtered subset of
      the traffic in its own window, and can record sessions to disk.
    </p>
    <p>
      UartX makes no assumption about how a device formats its messages. Every
      colour rule and every filter is defined by the user, so the same tool
      suits any firmware, board or module.
    </p>
    <p>Features:</p>
    <ul>
      <li>Configurable baud rate, data bits, parity, stop bits and flow control</li>
      <li>Keyword colour rules for highlighting important lines</li>
      <li>Filter windows showing only the lines you select, with savable output</li>
      <li>Optional session logging to plain-text files</li>
      <li>Named configurations that persist between runs</li>
    </ul>
  </description>

  <launchable type="desktop-id">@APP_DESKTOP_ID@.desktop</launchable>
  <url type="homepage">@APP_HOMEPAGE@</url>
  <url type="bugtracker">@APP_HOMEPAGE@/issues</url>
  <developer_name>@APP_COMPANY@</developer_name>

  <provides>
    <binary>UartX</binary>
  </provides>

  <categories>
    <category>Development</category>
    <category>Electronics</category>
  </categories>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="@PROJECT_VERSION@"/>
  </releases>
</component>
