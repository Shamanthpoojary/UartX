// Configured by CMake -- edit app.rc.in, never the generated app.rc.
// Gives the executable its icon and the version metadata Windows shows in
// Properties > Details, in the installer, and in Add/Remove Programs.

IDI_ICON1 ICON DISCARDABLE "@APP_ICON_PATH@"

1 VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@APP_COMPANY@"
            VALUE "FileDescription",  "@APP_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "UartX"
            VALUE "LegalCopyright",   "@APP_COPYRIGHT@"
            VALUE "OriginalFilename", "UartX.exe"
            VALUE "ProductName",      "@APP_PRODUCT@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
